localhost {
	tls internal

	handle /api/* {
		reverse_proxy web-api:8080
	}

	handle /graphql* {
		reverse_proxy web-api:8080
	}

	handle /openapi/* {
		reverse_proxy web-api:8080
	}

	handle /swagger {
		reverse_proxy web-api:8080
	}

	handle_path /ws/* {
		reverse_proxy notification-service:8080
	}
}
